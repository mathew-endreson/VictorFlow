node_modules/
dist/
.next/
.next-*/
.turbo/
.expo/
coverage/
*.tsbuildinfo

# env — only .env.example is committed
.env
.env.*
!.env.example

# local file storage (task proof photos etc.)
storage/*
!storage/.gitkeep

# tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
# server installer payload and download cache (apps/server-host/scripts/stage.mjs), and the installer itself
apps/server-host/.stage/
apps/server-host/.stage-cache/
apps/server-host/.dist/
dist-installer/

# two-PC trial install kit (scripts/trial-install/make-kit.mjs): downloaded installers, never committed
trial-kit/
scripts/trial-install/report-*.txt

# browser smoke-test screenshots
scripts/ui-smoke/shots/

.DS_Store
*.log

# Docker-free local PostgreSQL (scripts/local-postgres.mjs)
.local/

# licences and licence keys never belong in the repository (tools/licence-issuer refuses keys and ledgers inside it too)
*.vfl
licence-private-key*.pem
# the offline issuer kit (pnpm issuer:kit): node.exe + the bundled issuer, copied to BluxTech's offline PC by USB
licence-issuer-kit/
