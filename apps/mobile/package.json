{
  "name": "@victorflow/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "VictorFlow field-agent app (Expo / React Native) — offline-first tasks with sync",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@victorflow/i18n": "workspace:*",
    "@victorflow/types": "workspace:*",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.19",
    "expo-location": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
