{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VictorFlow",
  "version": "0.1.0",
  "identifier": "dz.victorflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VictorFlow",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources-staging/node": "node",
      "resources-staging/pg": "pg",
      "resources-staging/server": "server",
      "resources-staging/migrations": "migrations",
      "resources-staging/launcher.mjs": "launcher.mjs"
    }
  }
}
