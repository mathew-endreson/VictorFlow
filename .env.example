# ─────────────────────────────────────────────────────────────────────────────
# VictorFlow — local development environment
# `pnpm dev:up` copies this file to .env on first run. Every value below is a
# DEV default; nothing here is safe for a real deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Infrastructure (read by infrastructure/docker/docker-compose.yml) ───────
POSTGRES_USER=victorflow
POSTGRES_PASSWORD=victorflow
POSTGRES_DB=victorflow
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://victorflow:victorflow@localhost:5432/victorflow
REDIS_URL=redis://localhost:6379
# false → never connect to Redis (rate limiting + background jobs are then off). Handy without Docker.
REDIS_ENABLED=true
# Comma-separated list of browser/webview origins allowed to call the API.
# 1420 = desktop dev server, tauri.localhost / tauri://localhost = packaged Tauri shell.
CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,tauri://localhost,http://localhost:3001

# ── Auth ────────────────────────────────────────────────────────────────────
# MVP-NOTE: rotate these and load them from a secret manager outside dev.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-0123456789
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ── Public order tracking ───────────────────────────────────────────────────
# HMAC-SHA256 key used to derive tracking links. Changing it invalidates every
# link that has already been printed on a customer's paperwork.
TRACKING_HMAC_SECRET=dev-tracking-secret-change-me-0123456789abcdef
# Where the Next.js tracker is served; used to build the public URL / QR code.
TRACKER_BASE_URL=http://localhost:3001

# ── Local file storage (no MinIO in the MVP) ────────────────────────────────
# Relative paths resolve from the repo root.
STORAGE_DIR=./storage
# Largest accepted task-proof photo, in bytes (default 10 MiB).
UPLOAD_MAX_BYTES=10485760

# ── Background jobs ─────────────────────────────────────────────────────────
# BullMQ worker for the periodic audit-chain verification (needs Redis). Without Redis/queue the API verifies the chain hourly in-process instead.
QUEUE_ENABLED=true
# Set to true when the API sits behind ONE reverse proxy (nginx, Caddy…), so login/tracking rate limits see the real client IP.
TRUST_PROXY=false

# ── Licensing ───────────────────────────────────────────────────────────────
# dev    → always returns a valid PROFESSIONAL entitlement, no hardware check.
# crypto → verifies an Ed25519-signed licence file against the hardware id.
LICENSE_MODE=dev
# When false, no route is ever blocked by the licence (default for local dev).
LICENSE_ENFORCE=false
# Only used when LICENSE_MODE=crypto:
LICENSE_PUBLIC_KEY=
LICENSE_FILE=./license.vfl

# ── Seed data ───────────────────────────────────────────────────────────────
# Password given to every demo user created by `pnpm db:seed` (dev only).
# Password of every seeded account. In production it is REQUIRED to be set to something strong (12+ chars, not this default).
SEED_DEMO_PASSWORD=Admin123!

# ── Desktop / tracker front-ends ────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1
# Server-side (Next.js) URL of the API, used by apps/tracker.
TRACKER_API_URL=http://localhost:3000/api/v1
